# Credenciais de IA (mesmas já usadas nos outros apps — Audit AI, MedNote)
GEMINI_API_KEY=

# Fallback gratuito quando o Gemini estiver sobrecarregado/sem cota (mesmo padrão da Audit AI)
GROQ_API_KEY=
GROQ_API_KEY=

# NCBI/PubMed E-utilities recomenda uma API key para limites de taxa maiores (gratuita)
# https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_API_KEY=

# Firestore (projeto Firebase isolado do OrtoAI) — preenchido quando o projeto for criado
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PORT=3000
